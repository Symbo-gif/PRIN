+def _git_visible_files(root: Path) -> list[Path] | None:
+    """Tracked plus untracked-but-not-ignored files, or None outside git.
+
+    Git-ignored content (pytest base directories, tool worktrees, generated
+    results, build output) is scratch, not active project state. Walking it
+    made the inventory scan ~110,000 files / ~4 GB, so files appearing there
+    during the scan broke the determinism check (EVIDENCE/0159 leg 09c), and
+    it is where the intermittent access-violation crashes of the fast suite
+    occurred (0159 leg 09; EVIDENCE/0160 gate G12a).
+    """
+    executable = shutil.which("git")
+    if executable is None:
+        return None
+    try:
+        toplevel = subprocess.run(  # noqa: S603  # nosec B603
+            [executable, "-C", str(root), "rev-parse", "--show-toplevel"],
+            capture_output=True,
+            check=True,
+            text=True,
+            timeout=60,
+        ).stdout.strip()
+        # Only a work-tree root is inventoried through git; a directory nested
+        # in some other repository (e.g. a test's tmp_path) is walked instead.
+        if Path(toplevel).resolve() != root.resolve():
+            return None
+        listing = subprocess.run(  # noqa: S603  # nosec B603
+            [
+                executable,
+                "-C",
+                str(root),
+                "ls-files",
+                "-z",
+                "--cached",
+                "--others",
+                "--exclude-standard",
+            ],
+            capture_output=True,
+            check=True,
+            timeout=120,
+        ).stdout
+        names = sorted({name for name in listing.decode("utf-8").split("\0") if name})
+    except (OSError, subprocess.SubprocessError, UnicodeDecodeError):
+        return None
+    return [root / name for name in names]
+
+
