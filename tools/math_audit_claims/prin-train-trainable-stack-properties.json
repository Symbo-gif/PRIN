    {
      "claim_id": "HSL-01",
      "claim_type": "symbolic_identity",
      "statement": "Hungarian similarity loss on a uniform (all-zero) NxN similarity matrix with temperature T=0.1 yields -log(1/N) = log(N). For N=2: all logits are 0, softmax is uniform over 2 classes, so -log(1/2) = ln(2). This verifies the cross-entropy-over-softmax-diagonal formula in losses.rs:28-44 reduces to the correct entropy of the uniform distribution.",
      "code_refs": ["crates/prin-train/src/losses.rs:28-44"],
      "assumptions": {
        "lhs": "-(1/2)*(log(exp(0/T)/(exp(0/T)+exp(0/T))) + log(exp(0/T)/(exp(0/T)+exp(0/T))))",
        "rhs": "log(2)",
        "variables": ["T"],
        "domain": "real",
        "strategy": "symbolic_then_numeric",
        "numeric_samples": 10,
        "precision_digits": 30
      },
      "required_checks": ["verify_identity"],
      "severity": "medium",
      "crosscheck_required": false
    },
    {
      "claim_id": "DSILU-01",
      "claim_type": "symbolic_identity",
      "statement": "The derivative of SiLU(z) = z*sigma(z) is sigma(z) + z*sigma(z)*(1-sigma(z)), which is exactly what d_silu computes. At z=0: sigma(0)=1/2, so dSiLU(0) = 1/2 + 0*(1/2)*(1/2) = 1/2. This verifies the activation formula in activations.rs:82-86.",
      "code_refs": ["crates/prin-train/src/activations.rs:82-86"],
      "assumptions": {
        "lhs": "1/(1+exp(-z)) + z*(1/(1+exp(-z)))*(1 - 1/(1+exp(-z)))",
        "rhs": "1/(1+exp(-z)) + z*exp(-z)/(1+exp(-z))**2",
        "variables": ["z"],
        "domain": "real",
        "strategy": "symbolic_then_numeric",
        "numeric_samples": 40,
        "precision_digits": 30
      },
      "required_checks": ["verify_identity"],
      "severity": "high",
      "crosscheck_required": true
    },
    {
