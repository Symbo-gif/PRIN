      "claim_type": "z3_invariant",
      "statement": "oscillatory_weight_init's Coupling kind (weight_init.rs:37-55) produces a symmetric matrix with zero diagonal: (W + W^T)/2 * scale * (1 - I). For any 2x2 input [[a,b],[c,d]], the output is [[0, (b+c)/2*scale], [(b+c)/2*scale, 0]].",
      "code_refs": ["crates/prin-train/src/weight_init.rs:37-55"],
      "assumptions": {
        "variables": [
          {"name": "a", "sort": "Real"}, {"name": "b", "sort": "Real"},
          {"name": "c", "sort": "Real"}, {"name": "d", "sort": "Real"},
          {"name": "scale", "sort": "Real"},
          {"name": "out_00", "sort": "Real"}, {"name": "out_01", "sort": "Real"},
          {"name": "out_10", "sort": "Real"}, {"name": "out_11", "sort": "Real"}
        ],
        "constraints": [
          "scale > 0",
          "out_00 == 0",
          "out_11 == 0",
          "out_01 == (b + c) / 2 * scale",
          "out_10 == (b + c) / 2 * scale"
        ],
        "queries": [
          {"query_id": "weightinit-symmetric-zero-diag", "kind": "invariant_holds", "invariant": "And(out_00 == 0, out_11 == 0, out_01 == out_10)"}
        ],
        "timeout_ms": 10000,
        "produce_models": true,
        "maximize_counterexample_readability": true
      },
      "required_checks": ["check_constraint_model"],
      "severity": "high",
      "crosscheck_required": false
    },
