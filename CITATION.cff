cff-version: 1.2.0
message: "If you use PRIN in your research, please cite it as below."
title: "PRIN: Phase-Resonance Interference Network"
type: software
version: 1.0.0-rc1
license: MIT
repository-code: "https://github.com/Symbo-gif/PRIN"
authors:
  - family-names: Maillet
    given-names: Michael
    email: therealmichaelmaillet@gmail.com
  - family-names: Davison
